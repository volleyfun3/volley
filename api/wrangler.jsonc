{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "volley-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "INDEXER", "class_name": "Indexer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Indexer"] }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "RPC_URL": "https://rpc.testnet.chain.robinhood.com",
    "CHAIN_ID": "46630",
    "FACTORY": "0x6E9055a022BeC0F86cDcc5bD7AcB8A2847441d0E",
    "HOOK": "0xF44a38e9a6F1d6a160892beaB29455D7ef5ae8CC",
    "START_BLOCK": "129710633",
    "START_TICK": "200200"
  }
}
